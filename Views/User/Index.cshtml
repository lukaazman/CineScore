@model User
@using System.Linq

@{
    ViewData["Title"] = "User Profile";
}
<div>
    <h4>User Profile</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UserName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            @if (Model.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
            {
                <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Manage/Index">Manage profile</a>
            }
        </dt>
        <!-- Add more fields as needed -->
    </dl>
</div>

<div>
    <h4>Favorited Movies</h4>
    <hr />
    @{
        var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var isProfileOwner = Model.Id == currentUserId;
        var favorites = Model.Favorites != null ? Model.Favorites : new List<Favorite>();
    }
    @if (favorites.Any())
    {
        <div class="row row-cols-1 row-cols-md-5">
        @foreach (var favorite in favorites)
        {
            @await Html.PartialAsync("_MovieCard", new { Movie = favorite.Movie, ShowRemoveFavorite = isProfileOwner })
        }
        </div>
    }
    else
    {
        <p class="text-muted">No favorited movies yet.</p>
    }
</div>

<div>
    <h4>Reviews</h4>
    <hr />
    @if (Model.Comments != null && Model.Comments.Any())
    {
        foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
        {
            var likeCount = comment.Reactions?.Count(r => r.IsLike) ?? 0;
            var dislikeCount = comment.Reactions?.Count(r => !r.IsLike) ?? 0;
            <div class="mb-3 p-3 border rounded bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>@(comment.Rating)/5</strong>
                    <div>
                        <small class="text-muted">@comment.CreatedAt.ToString("MMMM dd, yyyy")</small>
                        @if (comment.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                            {
                                <form asp-action="DeleteComment" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@comment.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this comment?');">Delete</button>
                                </form>
                            }
                    </div>
                </div>
                <div>
                    <span class="fw-bold">Film:</span> @comment.Movie?.Title
                </div>
                <p class="mb-0">@comment.Text</p>
                <div class="d-flex align-items-center gap-3 mt-2">
                    <span class="d-flex align-items-center gap-1 text-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-hand-thumbs-up" viewBox="0 0 16 16">
                            <path d="M8.864.046C7.908-.193 7.02.53 6.956 1.52c-.072 1.105-.023 2.016-.928 2.621-.62.415-.86 1.12-.861 1.789v4.8c0 .918.36 1.522.783 1.86.406.33.805.318 1.09.255l.282-.07.342.457c.386.513.35 1.06.175 1.37-.176.311-.518.56-1.066.56H4.101c-.64 0-1.147-.525-1.147-1.17V6.965c0-.597.256-1.077.595-1.36.346-.287.723-.384 1.002-.296l.853-.255c.094-.03.157-.03.208-.03.177 0 .343-.065.45-.257.103-.18.122-.387.12-.56-.003-.25-.011-.515-.013-.77-.003-.353.064-.688.224-.95.098-.164.439-.488 1.04-.488.253 0 .487-.078.686-.223.378-.282.595-.926.517 1.57-.04-.32-.138-.611-.288-.868-.18-.31-.178-.579-.004-.81.255-.34.782-.467 1.148-.267.465-.25.803-.7.914-1.153.04-.164.068-.317.088-.465.08-.6.053-1.17.04-1.513-.015-.4.013-.772.11-1.03.137-.36.395-.56.563-.65.14-.075.304-.12.465-.12.203 0 .38-.05.518-.13.48-.27.934-1.092.622-2.908-.02-.12-.04-.248-.062-.39-.084-.57.1-1.292.777-1.5.394-.12.768-.074 1.093-.094.523-.28.83-.94.87-1.51.04-.61.017-1.28-.04-1.93-.054-.644-.142-1.28-.248-1.807-.117-.606-.45-1.365-1.021-1.85C12.49.734 11.559.36 10.422.36c-.403 0-.83.07-1.25.187z"></path>
                        </svg>
                        <span class="fw-semibold">@likeCount</span>
                    </span>
                    <span class="d-flex align-items-center gap-1 text-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-hand-thumbs-down" viewBox="0 0 16 16">
                            <path d="M8.864 15.674c-.956.24-1.843-.483-1.908-1.473-.072-1.105-.023-2.016-.928-2.621-.62-.415-.86-1.12-.861-1.789v-4.8c0-.918.36-1.522.783-1.86.406-.33.805-.318 1.09-.255l.282.07.342-.457c.386-.513.35-1.06.175-1.37-.176-.311-.518-.56-1.066-.56H4.101c-.64 0-1.147.525-1.147 1.17v5.224c0 .597.256-1.077.595-1.36.346-.287.723-.384 1.002-.296l.853-.255c.094-.03.157-.03.208-.03.177 0 .343-.065.45-.257.103-.18.122-.387.12-.56-.003-.25-.011-.515-.013-.77-.003-.353.064-.688.224-.95.098-.164.439-.488 1.04-.488.253 0 .487-.078.686-.223.378-.282.595-.926.517-1.57-.04-.32-.138-.611-.288-.868-.18-.31-.178-.579-.004-.81.255-.34.782-.467 1.148-.267.465-.25.803-.7.914-1.153.04-.164.068-.317.088-.465.08-.6.053-1.17.04-1.513-.015-.4.013-.772.11-1.03.137-.36.395-.56.563-.65.14-.075.304-.12.465-.12.203 0 .38-.05.518-.13.48-.27.934-1.092.622-2.908-.02-.12-.04-.248-.062-.39-.084-.57.1-1.292.777-1.5.394-.12.768-.074 1.093.094.523-.28.83-.94.87-1.51.04-.61.017-1.28-.04-1.93-.054-.644-.142-1.28-.248-1.807-.117-.606-.45-1.365-1.021-1.85-.745.632-1.676 1.006-2.813 1.006-.403 0-.83-.07-1.25-.187z"></path>
                        </svg>
                        <span class="fw-semibold">@dislikeCount</span>
                    </span>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">No reviews yet by this user.</p>
    }
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit Profile</a> |
    <a asp-action="Back">Back</a>
</div>
