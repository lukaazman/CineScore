@model User
@using System.Linq

@{
    ViewData["Title"] = "User Profile";
}
<div class="mb-5">
    <h4>User Profile</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UserName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            @if (Model.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
            {
                <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Manage/Index">Manage profile</a>
            }
        </dt>
    </dl>
</div>

<div class="mb-5">
    <h4>Favorited Movies</h4>
    <hr />
    @{
        var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var isProfileOwner = Model.Id == currentUserId;
        var favorites = Model.Favorites != null ? Model.Favorites : new List<Favorite>();
    }
    @if (favorites.Any())
    {
        <div class="row row-cols-1 row-cols-md-5">
        @foreach (var favorite in favorites)
        {
            @await Html.PartialAsync("_MovieCard", new { Movie = favorite.Movie, ShowRemoveFavorite = isProfileOwner })
        }
        </div>
    }
    else
    {
        <p class="text-muted">No favorited movies yet.</p>
    }
</div>

<div class="mb-5">
    <h4>Reviews</h4>
    <hr />
    @if (Model.Comments != null && Model.Comments.Any())
    {
        foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
        {
            var likeCount = comment.Reactions?.Count(r => r.IsLike) ?? 0;
            var dislikeCount = comment.Reactions?.Count(r => !r.IsLike) ?? 0;
            <div class="mb-3 p-3 border rounded bg-light">
                <div class="d-flex justify-content-between gap-2">
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a asp-controller="Movies"
                               asp-action="Details_user"
                               asp-route-id="@comment.MovieId"
                               class="fw-bold text-uppercase text-decoration-none text-dark">
                                @((comment.Movie?.Title ?? "Unknown").ToUpperInvariant())
                            </a>
                            <span class="fw-semibold">@comment.Rating/5</span>
                        </div>
                        <p class="mb-0 mt-1">@comment.Text</p>
                    </div>
                    <div class="d-flex align-items-start gap-2">
                        <small class="text-muted">@comment.CreatedAt.ToString("MMMM dd, yyyy")</small>
                        @if (comment.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <form asp-action="DeleteComment" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@comment.Id" />
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this comment?');">Delete</button>
                            </form>
                        }
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 mt-2">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 px-2 py-1" disabled title="Not allowed to react">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-hand-thumbs-up-fill" viewBox="0 0 16 16">
                                <path d="M6.956 1.745C7.021.81 7.908.087 8.864.325l.261.066c.463.116.874.456 1.012.965.22.816.533 2.511.062 4.51a10 10 0 0 1 .443-.051c.713-.065 1.669-.072 2.516.21.518.173.994.681 1.2 1.273.184.532.16 1.162-.234 1.733q.086.18.138.363c.077.27.113.567.113.856s-.036.586-.113.856c-.039.135-.09.273-.16.404.169.387.107.819-.003 1.148a3.2 3.2 0 0 1-.488.901c.054.152.076.312.076.465 0 .305-.089.625-.253.912C13.1 15.522 12.437 16 11.5 16H8c-.605 0-1.07-.081-1.466-.218a4.8 4.8 0 0 1-.97-.484l-.048-.03c-.504-.307-.999-.609-2.068-.722C2.682 14.464 2 13.846 2 13V9c0-.85.685-1.432 1.357-1.615.849-.232 1.574-.787 2.132-1.41.56-.627.914-1.28 1.039-1.639.199-.575.356-1.539.428-2.59z"/>
                            </svg>
                        </button>
                        <span class="small fw-semibold text-success">@likeCount</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 px-2 py-1" disabled title="Not allowed to react">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-hand-thumbs-down-fill" viewBox="0 0 16 16">
                                <path d="M6.956 14.534c.065.936.952 1.659 1.908 1.42l.261-.065a1.38 1.38 0 0 0 1.012-.965c.22-.816.533-2.512.062-4.51q.205.03.443.051c.713.065 1.669.071 2.516-.211.518-.173.994-.68 1.2-1.272a1.9 1.9 0 0 0-.234-1.734c.058-.118.103-.242.138-.362.077-.27.113-.568.113-.856 0-.29-.036-.586-.113-.857a2 2 0 0 0-.16-.403c.169-.387.107-.82-.003-1.149a3.2 3.2 0 0 0-.488-.9c.054-.153.076-.313.076-.465a1.86 1.86 0 0 0-.253-.912C13.1.757 12.437.28 11.5.28H8c-.605 0-1.07.08-1.466.217a4.8 4.8 0 0 0-.97.485l-.048.029c-.504.308-.999.61-2.068.723C2.682 1.815 2 2.434 2 3.279v4c0 .851.685 1.433 1.357 1.616.849.232 1.574.787 2.132 1.41.56.626.914 1.28 1.039 1.638.199.575.356 1.54.428 2.591z"/>
                            </svg>
                        </button>
                        <span class="small fw-semibold text-danger">@dislikeCount</span>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">No reviews yet by this user.</p>
    }
</div>
