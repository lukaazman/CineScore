@model dynamic

<div class="col">
    @{
        var posterUrl = string.IsNullOrWhiteSpace(Model.Movie.PosterUrl)
            ? "https://via.placeholder.com/220x330?text=No+Poster"
            : Model.Movie.PosterUrl;
    }
    <div class="card h-100 shadow-sm text-white border-0 overflow-hidden" style="max-width: 220px; background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.75) 100%), url('@posterUrl'); background-size: cover; background-position: center; min-height: 330px;">
        <div class="card-img-overlay d-flex flex-column justify-content-end p-3" style="backdrop-filter: blur(0px);">
            <div class="mb-3">
                <h6 class="card-title mb-1 fw-semibold" style="font-size:1em;">@Model.Movie.Title</h6>
                <p class="card-subtitle text-white-50 mb-0" style="font-size: 0.85em;">@Model.Movie.Year &middot; @Model.Movie.Genre</p>
            </div>
            <a asp-controller="Movies"
               asp-action="Details_user"
               asp-route-id="@Model.Movie.Id"
               class="btn btn-primary btn-sm w-100">
                View details
            </a>
            @if (Model.ShowRemoveFavorite == true)
            {
                <form asp-controller="User" asp-action="RemoveFavorite" method="post" class="mt-2">
                    <input type="hidden" name="movieId" value="@Model.Movie.Id" />
                    <button type="submit" class="btn btn-sm btn-danger w-100" onclick="return confirm('Remove this movie from favorites?');">Remove from Favorites</button>
                </form>
            }
        </div>
    </div>
</div>
